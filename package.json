{
	"name": "tracewise",
	"private": true,
	"description": "LLM observability and evaluation platform on serverless AWS",
	"type": "module",
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"synth": "cdk synth --quiet",
		"deploy": "cdk deploy --require-approval broadening",
		"tenant:create": "tsx scripts/create-tenant.ts"
	},
	"dependencies": {
		"@aws-sdk/client-athena": "3.1155.0",
		"@aws-sdk/client-bedrock-runtime": "3.1155.0",
		"@aws-sdk/client-cloudwatch": "3.1155.0",
		"@aws-sdk/client-dynamodb": "3.1155.0",
		"@aws-sdk/client-firehose": "3.1155.0",
		"@aws-sdk/client-sfn": "3.1155.0",
		"@aws-sdk/client-sns": "3.1155.0",
		"@aws-sdk/client-sqs": "3.1155.0",
		"@aws-sdk/lib-dynamodb": "3.1155.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@aws-sdk/client-cloudformation": "3.1155.0",
		"@types/aws-lambda": "8.10.164",
		"@types/node": "26.6.5",
		"aws-cdk-lib": "2.274.0",
		"constructs": "10.8.1",
		"esbuild": "0.28.2",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	}
}
